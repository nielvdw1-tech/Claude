# Copy this file to .env.local for local testing (vercel dev reads it).
# On Vercel, add the same values under Project > Settings > Environment Variables.

# API key from https://resend.com (API Keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# For local testing before your domain is verified in Resend, use Resend's test sender.
# It can only send to the email address you signed up to Resend with.
FROM_EMAIL=VDW Health & Safety Solutions <onboarding@resend.dev>

# Where new leads are emailed (default niel@vdwsafety.com)
LEAD_TO_EMAIL=niel@vdwsafety.com

# Set to false to stop emailing visitors a copy of their results
SEND_VISITOR_COPY=true
